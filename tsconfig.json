{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "#*": ["./agent/*"],
      "#evals/*": ["./evals/*"]
    }
  },
  "include": ["agent/**/*.ts", "evals/**/*.ts", "tests/**/*.ts"]
}
