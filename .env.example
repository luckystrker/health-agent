# ──────────────────────────────────────────────────────────────
# Health Agent — переменные окружения
# Копируй в `.env` (локально) или задаёшь в окружении на VPS.
# Секреты НИКОГДА не коммитить — только этот `.env.example`.
# ──────────────────────────────────────────────────────────────

# === Telegram (фаза 0) ===
# Токен бота из @BotFather.
TELEGRAM_BOT_TOKEN=
# Секретный токен webhook'а (X-Telegram-Bot-Api-Secret-Token). Должен совпадать
# с тем, что передан в setWebhook. Генерируется случайно.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Username бота без "@" — нужен для /cmd@bot-разрешения в группах.
TELEGRAM_BOT_USERNAME=
# Список разрешённых chat_id через запятую (allowlist). Чужие игнорируются молча.
# Узнать свой chat_id: напиши боту, затем проверь update через getUpdates, либо
# используй @userinfobot. Пример: 123456789,987654321
ALLOWED_CHAT_IDS=

# === БД — локальный Postgres 16 в Docker (фаза 0) ===
# Пароль для роли/БД `health`. Подставляется в docker-compose.yml и DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://health:PASSWORD@127.0.0.1:5432/health

# === Модель (фаза 0) ===
# API-ключ провайдера модели (см. agent/agent.ts: model).
MODEL_API_KEY=

# === Phone-hub (фаза 1) ===
# Соль для хэширования токенов forwarder'ов (SHA-256(salt + token)).
PHONE_HUB_TOKEN_SALT=

# === FatSecret (фаза 2) ===
# OAuth 2.0 client-credentials + OAuth 1.0a 3-legged. region=RU принудительно.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
